{
  "schema_version": 2,
  "status": "active",
  "owners": [
    "host",
    "inputs",
    "inputs-tests"
  ],
  "projects": [
    {
      "id": "inputs",
      "kind": "production",
      "manifest": "crates/inputs/Cargo.toml",
      "lockfile": "crates/inputs/Cargo.lock",
      "root": "crates/inputs",
      "test_project": "inputs-tests",
      "actions": {
        "verify_snapshot": {
          "operation": "verify.inputs-blobs",
          "tool": "verus",
          "argv": [
            "--crate-type=lib",
            "--no-cheating",
            "--no-external-by-default",
            "--num-threads",
            "2",
            "--output-json",
            "--compile",
            "--emit=link={operation_state}/verify.inputs-blobs.rlib,dep-info={operation_state}/verify.inputs-blobs.rlib.d",
            "crates/inputs/src/lib.rs",
            "-o",
            "{operation_state}/verify.inputs-blobs.rlib",
            "-Zchecksum-hash-algorithm=sha256"
          ],
          "output_contract": {
            "version": "0.2026.04.24.f8e1704",
            "commit": "f8e17045c4ac17a02e566b8997070f2eecc255be"
          }
        }
      },
      "language": "rust"
    },
    {
      "id": "inputs-tests",
      "kind": "test",
      "manifest": "crates/inputs-tests/Cargo.toml",
      "lockfile": "crates/inputs-tests/Cargo.lock",
      "root": "crates/inputs-tests",
      "tests_for": "inputs",
      "actions": {
        "verify_snapshot": {
          "operation": "verify.inputs-blobs-tests",
          "tool": "verus",
          "argv": [
            "--crate-type=lib",
            "--no-cheating",
            "--no-external-by-default",
            "--num-threads",
            "2",
            "--output-json",
            "--compile",
            "--emit=link={operation_state}/verify.inputs-blobs-tests.rlib,dep-info={operation_state}/verify.inputs-blobs-tests.rlib.d",
            "crates/inputs-tests/tests/snapshots.rs",
            "-o",
            "{operation_state}/verify.inputs-blobs-tests.rlib",
            "-Zchecksum-hash-algorithm=sha256"
          ],
          "output_contract": {
            "version": "0.2026.04.24.f8e1704",
            "commit": "f8e17045c4ac17a02e566b8997070f2eecc255be"
          }
        },
        "execute": {
          "operation": "inputs.owner-check",
          "tool": "bash",
          "argv": [
            "./check.sh",
            "--native"
          ]
        }
      },
      "language": "rust"
    }
  ],
  "scripts": []
}
